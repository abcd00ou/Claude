# Copy to .env.local for local dev; set these in Vercel Project Settings → Environment Variables for prod.

# Anthropic — required (generation + web search)
ANTHROPIC_API_KEY=sk-ant-...
# Defaults to claude-opus-4-8. Set to claude-sonnet-4-6 to cut cost.
ANTHROPIC_MODEL=claude-opus-4-8

# Resend — required to send the approved report to the CEO
RESEND_API_KEY=re_...
# Verified sender (must be a domain/address verified in Resend)
REPORT_FROM_EMAIL=reports@yourdomain.com
CEO_EMAIL=abcd00ou@gmail.com

# Cron guard — set to a random string; the 9am Vercel cron must send it.
CRON_SECRET=change-me-to-a-random-string

# Vercel KV (optional but recommended) — without it, drafts live in memory and
# don't survive between the cron run and review. Add the Vercel KV integration
# and these get set automatically.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
